# =============================================================================
# NEXION — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE
# Get these from: https://supabase.com/dashboard → your project → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# -----------------------------------------------------------------------------
# NEXTAUTH
# NEXTAUTH_SECRET: run `openssl rand -base64 32` to generate one
# NEXTAUTH_URL: use http://localhost:3000 for local dev
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# GOOGLE OAUTH (for "Continue with Google" login)
# Get these from: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret


# -----------------------------------------------------------------------------
# AI PROVIDERS
# Nexion uses a smart router: Groq (fast) → Gemini (PDF/long) → OpenRouter (fallback)
# All three are required for full functionality.
# -----------------------------------------------------------------------------

# GEMINI (primary for PDF / long-context tasks)
# Get your key from: https://aistudio.google.com/app/apikey
# Model in use: gemini-2.5-flash
GEMINI_API_KEY=your-gemini-api-key

# GROQ (primary for fast text Q&A)
# Get your key from: https://console.groq.com/keys
# Model in use: llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-api-key

# OPENROUTER (fallback provider)
# Get your key from: https://openrouter.ai/keys
# Model in use: meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_API_KEY=your-openrouter-api-key


# -----------------------------------------------------------------------------
# APP URL
# Used by OpenRouter's HTTP-Referer header and for absolute URL references.
# Change to your deployed domain when going live (e.g. https://nexion.vercel.app)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000